								{
									"key": "token",
									"value": "{{access_token}}"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"rating\": 5,\n    \"review_text\": \"An absolutely brilliant book! The writing is witty and the characters are memorable. A must-read for any sci-fi fan.\"\n}"
						},
						"url": {
